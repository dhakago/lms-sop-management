# Salin ke .env.local untuk pengembangan. Di Railway, isi lewat menu Variables. JANGAN simpan nilai asli di Git atau kirim lewat chat.

# Publik (boleh tampil di browser): dari Supabase, Project Settings, API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# RAHASIA, hanya di server (Railway Variables). Jangan pakai awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Alamat aplikasi, dipakai untuk tautan dan penanda cookie
NEXT_PUBLIC_APP_URL=https://lms.peopleexcellence.co.id

# Domain bayangan untuk akun yang login dengan nomor HP (tidak pernah dikirimi email)
AUTH_PHONE_DOMAIN=login.lms.peopleexcellence.co.id
